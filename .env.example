# ---------------------------------------------------------------------------
# Gateway Order-Reference Middleware — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# HTTP server
PORT=3000

# Order-number format. {DATE} => YYYYMMDD, {RAND} => random base32 chunk.
# Change the prefix/pattern to match your existing order scheme if you have one.
ORDER_NUMBER_PREFIX=ORD
ORDER_NUMBER_PATTERN={PREFIX}-{DATE}-{RAND}

# ---------------------------------------------------------------------------
# PayPal (REST API). Get these from the PayPal Developer dashboard.
# PAYPAL_ENV = sandbox | live
# ---------------------------------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# Webhook ID from PayPal dashboard (used to verify webhook signatures).
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# ---------------------------------------------------------------------------
# Stripe. Get these from the Stripe dashboard (use test keys for sandbox).
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Webhook signing secret (whsec_...) from the Stripe webhook endpoint config.
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Shows on the customer's card statement (<= 22 chars, letters/numbers/spaces).
STRIPE_STATEMENT_DESCRIPTOR_SUFFIX=ORDER

# ---------------------------------------------------------------------------
# Database. Default is a local SQLite file (zero-setup, great for sandbox).
# For production Postgres/MySQL see schema/ and swap src/db.js accordingly.
# ---------------------------------------------------------------------------
DB_FILE=./data/mapping.db
